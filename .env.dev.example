# ─────────────────────────────────────────────────────────────────
# Lab Lounge — 環境変数 dev プロファイル (差分のみ)
# ─────────────────────────────────────────────────────────────────
# 本ファイルは .env (本番) から分岐する dev プロファイル用の **差分** です。
# run_dev.ps1 は .env を base として読み込み (API キー等を継承)、
# その後このファイルで必要な値だけを上書きします。
# 本番と共通の値 (OPENAI_API_KEY / L2_USE_REAL_LLM 等) はここに書かずに
# .env から継承します。
#
# 使い方:
#   cp .env.dev.example .env.dev
#   .\scripts\run_dev.ps1
#
# 【必須上書き項目】 (dev と prod を分離するために必ず異なる値にする)
#   - REDIS_STREAM_KEY       本番 aibyss:events と別ストリーム
#   - L2_C2_URL              dev C2 (port 8101) を指す
#   - L2_ENABLE_RAG          true にして RAG 本体を有効化 (マスターフラグ)
#   - L2_USE_C2_RETRIEVER    true にして C2Retriever を CompositeRetriever に組み込む
#
# 【フラグの階層】
#   L2_ENABLE_RAG が false の場合、L2_USE_C2_RETRIEVER の値に関わらず
#   _retrieval_node は早期 return して C2Retriever は呼ばれない。
#   dev プロファイルで C2 経由の会話履歴 RAG を試す場合は両方を true にする。
#
# 【dev 限定オプション】
#   - L2_C2_URL_READONLY     prod C2 (port 8100) を副 read-only 参照
#                             ※ 本番の .env には絶対に設定しないこと
# ─────────────────────────────────────────────────────────────────

# 開発用ストリーム (dev 専用、本番と分離)
# dev L2 が publish する先。prod C2 はこのストリームを購読していないので
# 発話が prod DB に混入しない。
REDIS_STREAM_KEY=aibyss:events-dev

# RAG マスタースイッチ (本番 .env ではデフォルト false のため、dev で true に上書き)
# 前提: seed corpus index が data/index/ に構築済みであること
#       (未構築の場合は scripts/build_index.py を実行するか、L2_KB_PATH を
#        空の有効なディレクトリに向けること)
L2_ENABLE_RAG=true

# C2Retriever 有効化 (L2_ENABLE_RAG=true と組み合わせて初めて機能する)
L2_USE_C2_RETRIEVER=true

# 主 C2 = 開発 C2 (port 8101、c2-dev.db に書き込まれる)
L2_C2_URL=http://localhost:8101

# 副 C2 = 本番 C2 (port 8100、read-only で参照するだけ)
# dev L2 は本番の過去会話も検索できるが、dev の発話は絶対に本番 DB に
# 書き込まれない (非対称分離)
L2_C2_URL_READONLY=http://localhost:8100
