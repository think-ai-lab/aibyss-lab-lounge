# ─────────────────────────────────────────────────────────────────
# Lab Lounge — 環境変数テンプレート (本番 / prod プロファイル)
# ─────────────────────────────────────────────────────────────────
# 使い方: cp .env.example .env
# 開発・テスト用の分離プロファイルは .env.dev.example を参照。
# ─────────────────────────────────────────────────────────────────

REDIS_URL=redis://localhost:6379

# 本番ストリーム (publish 先)
REDIS_STREAM_KEY=aibyss:events

# AIBYSS_SCHEMA_PATH=  # 省略時は兄弟 aibyss-workspace/specs/ を自動探索

# ─── C2 (Coral Chronicle) 連携 — RAG 会話履歴参照 ───────────────
# false (デフォルト): 従来通り LocalRetriever (seed corpus) のみ
# true:              CompositeRetriever で LocalRetriever + C2Retriever をマージ
L2_USE_C2_RETRIEVER=false

# 主 C2 のベース URL (L2 が発行したイベントが consumer 経由で最終的に保存される C2)
# 本番モード: 本番 C2 の URL (:8100)
# 開発モード: 開発 C2 の URL (:8101)  ← dev C2 を起動する必要あり
L2_C2_URL=http://localhost:8100

# 副 C2 のベース URL (read-only で追加参照、任意)
# 本番モード: 未設定 (空文字列) ← 混入させない
# 開発モード: 本番 C2 の URL (:8100) を指定すると、dev L2 が prod データを読める
#   ※ 本番 L2 に本設定をすることは厳禁 (設計上は許可されるが、開発履歴汚染のため非推奨)
# L2_C2_URL_READONLY=

# C2Retriever の取得件数上限 (default: 3)
# L2_C2_RETRIEVER_TOP_K=3

# C2 HTTP リクエストのタイムアウト ms (default: 600)
# L2_C2_RETRIEVER_BUDGET_MS=600

# RecentC2Retriever を Composite に組み込むか (default: true、L2_USE_C2_RETRIEVER=true 時のみ有効)
# L2_USE_C2_RECENT=true

# RecentC2Retriever の取得件数 (default: 5)
# L2_C2_RECENT_TOP_K=5

# RecentC2Retriever の検索範囲 (default: global)
# global  = 全ストリーム横断で直近 N 件を取得 (セッションまたぎメモリ、新 run_loop でも過去を参照)
# session = 現ターンの stream_id のみに限定 (セッション内メモリ、過去 run_loop は見えない)
# L2_C2_RECENT_SCOPE=global

# ─── LLM 設定 ────────────────────────────────────────────
# false (デフォルト): "ダミー応答: {text}" を返す
# true:             real LLM を呼び llm.final に実値を格納する
L2_USE_REAL_LLM=false

# LLM プロバイダーとモデル名 (現在 openai のみ対応)
L2_LLM_PROVIDER=openai
L2_LLM_MODEL=gpt-5.4

# OpenAI API キー (秘密値 — .env に記載、リポジトリにコミットは絶対不可)
# OPENAI_API_KEY=sk-...

# ─── 配信文脈 ──────────────────────────────────────────────────────
# 「今日の配信内容」を記したファイルへのパス (Markdown)。
# 起動時 (run_loop / run_once) に1度だけ読み込まれ、各キャラの
# system_prompt に "## 本日の配信" セクションとしてマージされる。
#
# 省略時はデフォルト ./data/stream_context/current.md を参照する。
# ファイル未存在 / 空ファイル時は配信文脈なしで動作 (後方互換)。
#
# 推奨運用 (日付ベース命名): yyyymmdd_NN.md 形式で配信ごとにファイルを作り、
# .env でその日の配信ファイルを指す。current.md コピー操作が不要になる。
# 例: L2_STREAM_CONTEXT_FILE=./data/stream_context/20260506_01.md
#
# data/stream_context/ 配下の実ファイルは全て gitignore (current.example.md を除く)。
# 詳細は README.md「配信文脈のカスタマイズ」を参照。
# L2_STREAM_CONTEXT_FILE=

# ─── TTS 設定 ─────────────────────────────────────────────────────────────────
# false (デフォルト): dummy audio_url / duration_ms を使う
# true:              real TTS を呼び audio_url / duration_ms に実値を格納する
L2_USE_REAL_TTS=false

# TTS プロバイダ
#   "edge_tts"  : Microsoft Edge TTS (edge-tts パッケージ必要。無料)
#   "voicevox"  : VOICEVOX Engine HTTP API (ローカルサーバ必要)
L2_TTS_PROVIDER=voicevox

# 音声識別子 (provider 依存)
#   edge_tts  : Edge TTS 音声名  例: "ja-JP-NanamiNeural", "ja-JP-KeitaNeural"
#   voicevox  : スピーカー ID (整数文字列)  例: "3" (ずんだもん), "8" (春日部つむぎ)
#              Voidoll のスタイル ID は VOICEVOX Engine の /speakers で確認してください
L2_TTS_VOICE=89

# 人可読スピーカー名（tts.done payload.speaker に格納されるメタデータ）
L2_TTS_SPEAKER=Voidoll

# 音声ファイル保存先
L2_TTS_OUTPUT_DIR=./data/audio

# VOICEVOX Engine URL (voicevox provider のみ使用)
# docker run -p 50021:50021 voicevox/voicevox_engine:latest
L2_TTS_VOICEVOX_URL=http://localhost:50021

# ─── STT 設定 ─────────────────────────────────────────────────────────────────────────────
# false (デフォルト): --audio-file が指定されてもダミーテキストを使う
# true:             real STT (Whisper) を呼び、実値テキストを取得する
L2_USE_REAL_STT=false

# STT プロバイダ
#   "openai"        : OpenAI Whisper API (クラウド、API キー必要)
#   "faster-whisper": faster-whisper (ローカル、GPU 推奨)
# Phase 0.5-A 推奨: faster-whisper (API コストゼロ + hallucination 抑止可能)
L2_STT_PROVIDER=faster-whisper

# 認識言語 (ISO 639-1)
L2_STT_LANG=ja

# Whisper モデル名
#   openai provider:        "whisper-1"
#   faster-whisper provider: "large-v3" (最高精度) / "medium" / "small" (速度優先)
L2_STT_MODEL=large-v3

# faster-whisper 限定: GPU/CPU 選択 + 計算精度
L2_STT_DEVICE=cuda
L2_STT_COMPUTE_TYPE=float16

# faster-whisper 限定: hallucination 抑止パラメータ (Phase 0.5-A で追加)
# 「ご視聴ありがとうございました」「おやすみなさい」等の無音時誤生成を抑止する。
L2_STT_HALLUCINATION_FILTER=true
L2_STT_CONDITION_ON_PREVIOUS_TEXT=false
# L2_STT_COMPRESSION_RATIO_THRESHOLD=2.4
# L2_STT_LOG_PROB_THRESHOLD=-1.0
# L2_STT_NO_SPEECH_THRESHOLD=0.6
# L2_STT_HALLUCINATION_EXTRA_PATTERNS=またね,お疲れ様でした

# OpenAI API キーは LLM と共用できます (上記 OPENAI_API_KEY を遡用、openai provider のみ)

# ─── LangSmith 設定 ───────────────────────────────────────────────────────────
# false (デフォルト): LangSmith へのトレース送信を無効にする
# true:             LangChain / LangGraph 実行を LangSmith に送信する
LANGSMITH_TRACING=false

# LangSmith API キー (秘密値 — .env に記載、リポジトリにコミットは絶対不可)
# LANGSMITH_API_KEY=lsv2_pt_...

# LangSmith プロジェクト名 (省略時は "default")
LANGSMITH_PROJECT=aibyss-lab-lounge

# ─── マイク録音 / 再生設定 (run_once.py) ─────────────────────────────────────
# 1 回録音して 1 往復会話する run_once.py 向け設定。
# 前提: uv sync --extra mic --extra stt --extra llm --extra tts

# 録音秒数 (CLI --record-seconds で上書き可)
L2_RECORD_SECONDS=5

# 録音一時ファイルの保存先 (省略時は OS tmpdir)
# L2_TMP_DIR=./data/tmp

# true にすると TTS 再生をスキップしてファイルパスのみ表示
L2_NO_PLAY=false

# ─── VAD (発話検知) 設定 ────────────────────────────────────────
# Sprint Axis A' で WebRTC VAD を統合。Sprint Axis B Block 3 の VA-2 実機検証で
# aggressiveness=3 が実用レベルに達したことを確認済み。新規環境では webrtc 推奨。
#
# - rms (旧デフォルト): L2_SILENCE_THRESHOLD を使った素朴な音量閾値判定。
#                        マイク個別のキャリブレーションが必要。
# - webrtc (推奨):      Google WebRTC VAD。aggressiveness 0-3 で感度調整。
#                        マイク個別のキャリブレーション不要。
L2_VAD_BACKEND=webrtc

# WebRTC VAD の aggressiveness (0=最も緩い / 3=最も厳しい)
# 3 は環境ノイズに強いが、静かな発話を見落とす可能性がある
# 2 がバランス良好だが、環境ノイズが多い場合は 3 へ
L2_VAD_AGGRESSIVENESS=3

# RMS VAD フォールバック用の無音判定しきい値 (L2_VAD_BACKEND=rms 時のみ使用)
# 約 0.001−0.01 で調整。scripts/calibrate_silence.py で環境別に計測可能
# L2_SILENCE_THRESHOLD=0.005

# オーディオデバイスのインデックスまたは名前 (省略時はデフォルトデバイス)
# L2_AUDIO_DEVICE=0
# 利用可能なデバイス一覧: uv run python -c "import sounddevice; print(sounddevice.query_devices())"

# ─── VOICEPEAK リトライ設定 ────────────────────────────────────────
# VOICEPEAK は同時並列実行が 1 プロセスまで制限されており、フィラー TTS と
# 本応答 TTS が衝突すると "In this version, up to 1 command line instance ..."
# のエラーで失敗する。また Windows 上では稀にクラッシュ (returncode != 0) する。
# どちらも自動リトライで救済する設計。
#
# Phase 0.5-A フェーズ 8 (実走対応): 旧 2s × 2 回 = 最大 4s 待機 から
# 1s × 8 回 = 最大 8s 待機に変更。クラッシュ後の応答開始遅延を短縮しつつ、
# 回数で完走確率をカバーする。busy と crash で wait は同値 (倍率撤廃)。

# リトライ前の待機秒数 (busy / crash 共通、default 1.0 = 1 秒)
L2_VOICEPEAK_RETRY_WAIT_SEC=1.0

# 最大リトライ回数 (default 8、初回試行を除く追加試行回数)
L2_VOICEPEAK_MAX_RETRIES=8

# ─── Phase 0.5-A: 挙手システム (handraise) ──────────────────────────
# `--wake-backend bg-continuous` の常時録音上で「呼ばれていないが自分の関心領域に
# 触れた」発話に対してキャラが自発的に挙手し、ルカが「ミミ、どうぞ」で承認する仕組み。
# 設計記録: Notion 346e38612fe88190a79cd07c0d9c1484
#
# 機能 on/off (default true)。false にすると意図ゲートと dispatcher の判定が
# 動かず、bg-continuous でも従来通り wake_event のみ反応する。
L2_USE_HANDRAISE=true

# 挙手から自動取り下げ (lapse) までの秒数 (default 300 = 5 分)。
# 複数キャラの連鎖挙手を考慮した設定値。承認/却下されないまま経過すると
# bubble.update("lapsed") が発行されて状態が解消する。
L2_HANDRAISE_LAPSE_SEC=300

# 挙手後にルカが何発話別の話題で続けたら自動取り下げするかの閾値 (default 8)。
# check_intent が「関係ない発話」と判定した回数のカウント上限。
L2_HANDRAISE_LAPSE_UTTERANCE_COUNT=8

# RESPONDING 中に挙手したキャラの handraise wav は IDLE 復帰後に再生されるが、
# 応答完了直後の連続再生を避けるため間に空白を入れる秒数 (default 1.5)。
# 0 で空白なし (即時再生)。1-2 秒程度が視聴者体験的に自然。
L2_HANDRAISE_RESPONDING_PADDING_SEC=1.5
